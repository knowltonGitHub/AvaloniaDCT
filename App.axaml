<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniaDCT.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
        <!--
          Fluent uses the same fill for enabled and disabled buttons, so the
          two states read as the same grey chip. Disabled buttons drop that
          fill and keep the theme's muted foreground and a hairline border.
        -->
        <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundDisabled}" />
        </Style>
        <!--
          Avalonia 12 draws its own title bar on Linux. The leftmost caption
          button is fullscreen; its 11px expand glyph reads as an unlabeled
          caret. Name the caption buttons and enlarge those glyphs.
        -->
        <Style Selector="WindowDrawnDecorations /template/ Button#PART_FullScreenButton">
            <Setter Property="ToolTip.Tip" Value="Full screen" />
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ Button#PART_PopoverFullScreenButton">
            <Setter Property="ToolTip.Tip" Value="Exit full screen" />
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ Button#PART_MinimizeButton">
            <Setter Property="ToolTip.Tip" Value="Minimize" />
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ Button#PART_MaximizeButton">
            <Setter Property="ToolTip.Tip" Value="Maximize" />
        </Style>
        <Style Selector="WindowDrawnDecorations:maximized /template/ Button#PART_MaximizeButton">
            <Setter Property="ToolTip.Tip" Value="Restore" />
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ Button#PART_CloseButton">
            <Setter Property="ToolTip.Tip" Value="Close" />
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ Button#PART_PopoverCloseButton">
            <Setter Property="ToolTip.Tip" Value="Close" />
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ Button Viewbox">
            <Setter Property="Width" Value="15" />
        </Style>
    </Application.Styles>
</Application>