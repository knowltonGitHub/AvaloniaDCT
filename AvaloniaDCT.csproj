<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe = Windows GUI, no console window when double-clicked. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Fail the build if a {Binding Foo} name does not exist on x:DataType. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>1.0.0</Version>
    <Product>Desktop Clipboard Toolkit</Product>
    <Authors>knowlton</Authors>
    <ApplicationTitle>Desktop Clipboard Toolkit</ApplicationTitle>
    <RootNamespace>AvaloniaDCT</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <!-- DevTools support; stripped from Release so it is not in the installer. -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <!-- [ObservableProperty] and [RelayCommand] source generators. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- Core = no vanilla sqlite3. Pair with SQLCipher native bundle below. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep the WinForms snapshot in the repo but out of this compile. -->
    <Compile Remove="LEGACY DCT\**" />
    <EmbeddedResource Remove="LEGACY DCT\**" />
    <AvaloniaResource Remove="LEGACY DCT\**" />
    <None Remove="LEGACY DCT\**" />
  </ItemGroup>
</Project>
