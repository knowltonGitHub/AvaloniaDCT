<!-- Preferences: SMTP settings only. Email send is not hooked up yet; Save still writes SQLite. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaDCT.ViewModels"
        x:Class="AvaloniaDCT.Views.PreferencesWindow"
        x:DataType="vm:PreferencesViewModel"
        Title="Preferences"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <!-- Compiled bindings to PreferencesViewModel. Height fits the email form. CenterOwner, no taskbar button. -->
    <!-- LAN chat IP/port live on the main window Chat tab, not here. -->

    <DockPanel Margin="12">
        <!-- Cancel / Save row. -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,12,0,0">
            <Button Content="Cancel"
                    MinWidth="90"
                    Command="{Binding CancelCommand}" />
            <Button Content="Save"
                    MinWidth="90"
                    Command="{Binding SaveCommand}" />
        </StackPanel>

        <StackPanel Margin="4" Spacing="8">
            <TextBlock Text="Enter your Gmail SMTP settings."
                       TextWrapping="Wrap"
                       Opacity="0.8" />
            <TextBlock Text="From Address" />
            <TextBox Text="{Binding FromAddress}" />
            <TextBlock Text="Host" />
            <TextBox Text="{Binding Host}" />
            <TextBlock Text="Port" />
            <TextBox Text="{Binding Port}" />
            <TextBlock Text="User name" />
            <TextBox Text="{Binding UserName}" />
            <TextBlock Text="Password" />
            <TextBox Text="{Binding Password}" PasswordChar="*" />
        </StackPanel>
    </DockPanel>
</Window>
