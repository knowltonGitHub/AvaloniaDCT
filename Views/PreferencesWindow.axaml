<!-- Preferences: two tabs bound to PreferencesViewModel. Email send is not hooked up yet; Save still writes SQLite. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaDCT.ViewModels"
        x:Class="AvaloniaDCT.Views.PreferencesWindow"
        x:DataType="vm:PreferencesViewModel"
        Title="Preferences"
        Width="560"
        Height="420"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <!-- Compiled bindings to PreferencesViewModel. Fixed size, centered on MainWindow, no taskbar button. -->

    <!-- Buttons docked at the bottom; TabControl fills the rest. -->
    <DockPanel Margin="12">
        <!-- Cancel / Save row. Dock Bottom so the tabs get leftover height. -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,12,0,0">
            <!-- CancelCommand closes without writing. -->
            <Button Content="Cancel"
                    MinWidth="90"
                    Command="{Binding CancelCommand}" />
            <!-- SaveCommand writes preferences then closes. -->
            <Button Content="Save"
                    MinWidth="90"
                    Command="{Binding SaveCommand}" />
        </StackPanel>

        <!-- Two tabs: Email SMTP and home-network IPs. -->
        <TabControl>
            <!-- SMTP fields from the WinForms Preferences form. -->
            <TabItem Header="Email">
                <StackPanel Margin="16" Spacing="8">
                    <!-- Hint; send is not wired in Avalonia yet. -->
                    <TextBlock Text="Enter your Gmail SMTP settings."
                               TextWrapping="Wrap"
                               Opacity="0.8" />
                    <!-- From Address label + two-way FromAddress. -->
                    <TextBlock Text="From Address" />
                    <TextBox Text="{Binding FromAddress}" />
                    <!-- Host label + two-way Host. -->
                    <TextBlock Text="Host" />
                    <TextBox Text="{Binding Host}" />
                    <!-- Port label + two-way Port. -->
                    <TextBlock Text="Port" />
                    <TextBox Text="{Binding Port}" />
                    <!-- SMTP user name. -->
                    <TextBlock Text="User name" />
                    <TextBox Text="{Binding UserName}" />
                    <!-- SMTP password; PasswordChar masks display. -->
                    <TextBlock Text="Password" />
                    <TextBox Text="{Binding Password}" PasswordChar="*" />
                </StackPanel>
            </TabItem>
            <!-- LAN source/destination from the WinForms form. -->
            <TabItem Header="Home Network Settings">
                <StackPanel Margin="16" Spacing="12">
                    <!-- Source (this PC) heading. -->
                    <TextBlock Text="Source (your PC)" FontWeight="SemiBold" />
                    <!-- 80px label column, * field column. Two rows: IP then Port. -->
                    <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                        <!-- Row 0 col 0: IP label. -->
                        <TextBlock Text="IP" VerticalAlignment="Center" />
                        <!-- Row 0 col 1: SourceIp. -->
                        <TextBox Grid.Column="1" Text="{Binding SourceIp}" />
                        <!-- Row 1 col 0: Port label. -->
                        <TextBlock Grid.Row="1" Text="Port" VerticalAlignment="Center" />
                        <!-- Row 1 col 1: SourcePort. -->
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SourcePort}" />
                    </Grid>
                    <!-- Destination heading. Extra top margin to separate from source. -->
                    <TextBlock Text="Destination" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <!-- Same 2x2 grid for destination. -->
                    <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                        <!-- Row 0 col 0: IP label. -->
                        <TextBlock Text="IP" VerticalAlignment="Center" />
                        <!-- Row 0 col 1: DestinationIp. -->
                        <TextBox Grid.Column="1" Text="{Binding DestinationIp}" />
                        <!-- Row 1 col 0: Port label. -->
                        <TextBlock Grid.Row="1" Text="Port" VerticalAlignment="Center" />
                        <!-- Row 1 col 1: DestinationPort. -->
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DestinationPort}" />
                    </Grid>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
